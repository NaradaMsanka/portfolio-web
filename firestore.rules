rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "zilxs1iQp3Nd17CsNE1ywTgY9jJ2";
    }

    match /projects/{projectId} {
      allow read: if isAdmin()
        || resource.data.published == true;

      allow create, update, delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if isAdmin()
        || resource.data.published == true;

      allow create, update, delete: if isAdmin();
    }

    match /companyLogos/{logoId} {
      allow read: if isAdmin()
        || resource.data.published == true;

      allow create, update, delete: if isAdmin();
    }

    match /enquiries/{enquiryId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          "name",
          "email",
          "phone",
          "type",
          "message",
          "status",
          "createdAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 30
        && request.resource.data.type is string
        && request.resource.data.type.size() <= 80
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 3000
        && (
          !request.resource.data.keys().hasAny(["status"])
          || request.resource.data.status == "unread"
        );

      allow read, delete: if isAdmin();
      allow update: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
